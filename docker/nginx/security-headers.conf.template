# Security headers for every HTML and asset response.
#
# scripts/csp-hashes.mjs renders this file after `next build`: the script-src
# placeholder becomes 'self' plus a sha256 hash for each inline <script> in the
# exported pages, so script-src never needs 'unsafe-inline'. 'unsafe-inline' remains
# for styles only, for React's style="" attributes. Fonts are self-hosted by
# next/font. The one third-party origin is docs.google.com, which the Contact
# page's form posts to (connect-src); nothing third-party is framed or loaded.
#
# HSTS is set by Traefik, where TLS ends.
add_header Content-Security-Policy "default-src 'self'; script-src __SCRIPT_SRC__; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://docs.google.com; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
add_header X-Content-Type-Options "nosniff" always;
add_header X-Frame-Options "DENY" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
