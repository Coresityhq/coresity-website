{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Dev Server",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev"
    },
    {
      "name": "Launch Web debugger",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:8910",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "Unit tests",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm test"
    }
  ]
}
